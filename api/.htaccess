# Bloquer l'accès direct aux fichiers sensibles
Options -Indexes

<Files "db.php">
  Order Allow,Deny
  Deny from all
</Files>
<Files "helpers.php">
  Order Allow,Deny
  Deny from all
</Files>

# NB : les requêtes OPTIONS (preflight) doivent atteindre PHP, qui renvoie
# les en-têtes CORS (helpers.php > set_cors). Ne pas les court-circuiter ici.

# Sécurité
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
</IfModule>
